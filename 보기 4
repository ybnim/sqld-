DDL: INSERT문
INSERT INTO 테이블명(칼럼1, 칼럼2, 칼럼3...)
VALUES(값1, 값2 ....)

UPDATE문
UPDATE 테이블명
SET 칼럼1 = 값1, 칼럼2 = 값2 ...
WHERE 조건;

DELETE문
DELETE FROM 테이블명
WHERE 조건;

MERGE문
MERGE INTO 타깃_테이블 타깃(별칭)
  USING 소스_테이블 소스(별칭)
    ON (타깃.조건_칼럼 = 소스.조건_칼럼)
    WHEN MATCHED THEN
      UPDATE SET 타깃.칼럼1 = 소스.칼럼1\ ....
